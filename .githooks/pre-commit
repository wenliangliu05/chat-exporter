#!/bin/sh
# ============================================================
# 提交前闸门：本地数据 / 凭据 一律不许进仓库
#
# 为什么要这个钩子：.gitignore 只防"没被跟踪的文件"，
# 一旦有人 `git add -f` 或文件先被跟踪过，ignore 就形同虚设。
# 这里在提交瞬间再查一遍"路径 + 内容"，双保险。
#
# 启用：git config core.hooksPath .githooks
#      （或运行 scripts/setup-hooks.sh / setup-hooks.cmd）
# ============================================================
set -e

staged=$(git diff --cached --name-only --diff-filter=ACM)

# --- 1. 路径检查 ---
blocked=$(echo "$staged" | grep -Ei '(^|/)(data|logs)/|(^|/)snapshot\.db$|\.db(-wal|-shm)?$|\.sqlite3?$|(^|/)cookie[^/]*\.txt$|(^|/)\.env($|\.)|(^|/)\.chatexporter/|\.log$|\.local\.json$' || true)
if [ -n "$blocked" ]; then
  echo ""
  echo "✗ 提交被拒绝：以下文件属于本地数据 / 凭据，不应入库"
  echo "------------------------------------------------------------"
  echo "$blocked" | sed 's/^/    /'
  echo "------------------------------------------------------------"
  echo "  如果确实需要排除误判，请用：git reset HEAD <文件>"
  echo ""
  exit 1
fi

# --- 2. 内容检查（只看本次新增的行）---
secrets=$(git diff --cached -U0 -- . ':!.githooks' | grep -Eai \
  'sessionid=[0-9a-f]{16,}|oai-did=[0-9a-f-]{16,}|sid_guard=[A-Za-z0-9%|_-]{20,}|__Secure-next-auth\.session-token\.[0-9]=|__Host-next-auth\.csrf-token|cf_clearance=[A-Za-z0-9%._-]{20,}|Bearer [A-Za-z0-9._-]{40,}|sk-[A-Za-z0-9]{24,}' || true)
if [ -n "$secrets" ]; then
  echo ""
  echo "✗ 提交被拒绝：暂存区疑似包含 Cookie / Token / API Key"
  echo "------------------------------------------------------------"
  echo "$secrets" | cut -c1-120 | sed 's/^/    /'
  echo "------------------------------------------------------------"
  echo "  请把这些值移到 data/cookie-<platform>.txt（已在 .gitignore 内）"
  echo ""
  exit 1
fi

# --- 3. 体积检查：防止误提交大文件（数据库/导出包）---
big=$(echo "$staged" | while read -r f; do
  [ -f "$f" ] || continue
  size=$(wc -c < "$f" 2>/dev/null || echo 0)
  [ "$size" -gt 5242880 ] && echo "$f ($((size/1024/1024)) MB)"
done || true)
if [ -n "$big" ]; then
  echo "✗ 提交被拒绝：以下文件超过 5 MB"
  echo "$big" | sed 's/^/    /'
  exit 1
fi

exit 0
